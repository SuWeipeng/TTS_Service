# TTS Service 配置文件示例
# 复制此文件为 .env 并修改配置

# 模型选择 (kokoro 或 melo)
TTS_MODEL=kokoro

# 服务器设置
HOST=0.0.0.0
PORT=8000

# 音频设置
SAMPLE_RATE=24000
DEFAULT_AUDIO_FORMAT=mp3
ENABLE_MP3=true

# Kokoro 配置
KOKORO_REPO_ID=kokoro_api
KOKORO_CONFIG_PATH=models/kokoro/models_zh/config.json
KOKORO_MODEL_PATH=models/kokoro/models_zh/kokoro-v1_1-zh.pth
KOKORO_VOICES_DIR=models/kokoro/voices
KOKORO_VOICE_MAPPING=models/kokoro/voice_mapping.json

# MeloTTS 配置
MELO_DEVICE=auto
MELO_VOICE_MAPPING=models/melo/voice_mapping.json

# OpenAI API 兼容性
STRICT_OPENAI_COMPATIBILITY=true
MAX_TEXT_LENGTH=4096
MIN_SPEED=0.25
MAX_SPEED=4.0

# CORS 设置（生产环境应限制）
CORS_ORIGINS=["*"]

# 日志设置
LOG_LEVEL=INFO

# 队列管理设置
MAX_QUEUE_SIZE=100
